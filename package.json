{
  "name": "vps-terminal",
  "version": "1.29.0",
  "private": false,
  "description": "Mobile-first tmux terminal PWA for a Linux host (reverse-proxy auth)",
  "license": "MIT",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/revolt3r-vps/vps-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/revolt3r-vps/vps-terminal/issues"
  },
  "homepage": "https://github.com/revolt3r-vps/vps-terminal#readme",
  "scripts": {
    "start": "node server.js",
    "check": "bash scripts/check.sh --syntax",
    "qa:games-view": "node qa/games-view.js",
    "vendor": "bash scripts/vendor-assets.sh",
    "test": "bash scripts/check.sh",
    "qa:files-delete": "node qa/files-delete.js",
  },
  "files": [
    "server.js",
    "diagnostics.js",
    "fs-jail.js",
    "preferences-store.js",
    "attach-session",
    "shell-integration.bash",
    "bin/**/*",
    "public/**/*",
    "scripts/**/*",
    "examples/**/*",
    "docs/**/*",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.21.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  }
}
