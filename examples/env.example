# Copy values into your systemd unit Environment= lines or an EnvironmentFile=.
# Never commit a real .env with secrets (this app has no OAuth secrets of its own).

# Required outside LOCAL_DEV — exact public origin used for CSRF/WebSocket checks
VPS_TERMINAL_ORIGIN=https://terminal.example.com

# Production listen mode (recommended): Unix socket for reverse proxy only
VPS_TERMINAL_SOCKET=/home/YOU/.local/share/vps-terminal/run/terminal.sock

# Optional branding / paths
VPS_TERMINAL_APP_NAME=VPS Terminal
VPS_TERMINAL_PROJECT_ROOT=/home/YOU/projects
# VPS_TERMINAL_PASTE_ROOT=/home/YOU/paste
# VPS_TERMINAL_FS_HOME=0
# VPS_TERMINAL_FS_EXTRA=logs:logs:/var/log:ro

# Games view: one directory per game, and where a game is published.
# The setting appears per account once the root exists; the Play link needs
# the URL template, which must be https and contain {slug}.
# VPS_TERMINAL_GAMES_ROOT=/home/YOU/projects/games
# VPS_TERMINAL_GAME_URL=https://{slug}.play.example.com/

# Local development only (never with SOCKET; never on a public interface)
# VPS_TERMINAL_LOCAL_DEV=1
# VPS_TERMINAL_HOST=127.0.0.1
# VPS_TERMINAL_PORT=3099
# VPS_TERMINAL_DEV_EMAIL=dev@localhost.test
# VPS_TERMINAL_CLIENT_DEBUG=1
